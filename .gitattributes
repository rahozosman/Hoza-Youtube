# ---------------------------------------------------------------------------
# Line endings
#
# Everything is stored with LF. This matters beyond tidiness: the CI workflows
# embed shell heredocs, and a stray CR would leave the terminator unmatched on
# the Linux runner.
#
# The Windows scripts are the exception. cmd.exe and the Windows Script Host
# both want CRLF, so those are checked out with CRLF whatever the platform.
# ---------------------------------------------------------------------------

* text=auto eol=lf

*.bat  text eol=crlf
*.cmd  text eol=crlf
*.ps1  text eol=crlf
*.vbs  text eol=crlf

# ---------------------------------------------------------------------------
# Binaries - never touched, never diffed as text.
# ---------------------------------------------------------------------------

*.png  binary
*.jpg  binary
*.gif  binary
*.ico  binary
*.mp4  binary
*.webm binary
*.zip  binary
*.crx  binary
*.db   binary

# Keeps the demo out of diffs and out of language statistics.
docs/** linguist-documentation
